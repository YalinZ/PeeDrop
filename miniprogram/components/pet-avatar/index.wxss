:host { display: block; width: 100%; height: 100%; }
.pet-avatar { position: relative; width: 100%; height: 100%; background: #F9F8F4; overflow: hidden; }
.pet-avatar-image { display: block; width: 100%; height: 100%; }
.avatar-state { position: absolute; top: 0; left: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #F9F8F4; color: #1A1A1A; font-size: 20rpx; font-weight: 800; }
