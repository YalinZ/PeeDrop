/* 组件样式隔离：局部复制同名令牌，与 app.wxss 保持一致。 */
.tab-bar {
  --bg-cream: #F9F8F4;
  --primary-green: #2CB67D;
  --accent-yellow: #FFC000;
  --ink: #1A1A1A;
  --surface-white: #FFFFFF;
  --border-bold: 4rpx solid var(--ink);
  --radius-pill: 100rpx;
  --radius-card: 40rpx;
  --shadow-hard: 6rpx 6rpx 0 var(--ink);
  --shadow-pressed: 2rpx 2rpx 0 var(--ink);
  position: fixed;
  left: 50%;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  z-index: 9999;
  display: flex;
  align-items: center;
  width: 90%;
  height: 144rpx;
  padding: 10rpx;
  box-sizing: border-box;
  background-color: var(--bg-cream);
  border: var(--border-bold);
  border-top: var(--border-bold);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-hard);
}
.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 112rpx;
  margin: 0 8rpx;
  padding: 4rpx;
  border: var(--border-bold);
  border-radius: var(--radius-pill);
  background: var(--surface-white);
  color: var(--ink);
  line-height: 1.3;
  box-shadow: 3rpx 3rpx 0 var(--ink);
  transition: transform 120ms ease, box-shadow 120ms ease;
}
.tab-item--selected { background: var(--accent-yellow); }
.tab-item::after, .paw-action::after { border: 0; }
.tab-icon { width: 52rpx; height: 52rpx; margin-bottom: 2rpx; }
.tab-text { color: var(--ink); font-size: 22rpx; font-weight: 800; }
.text-green { color: var(--ink); }
.tab-item--pressed { transform: translate(2rpx, 2rpx); box-shadow: none; }
.paw-slot {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transform: translateY(-24rpx);
}
.paw-action {
  width: 140rpx;
  height: 140rpx;
  margin: 0;
  padding: 6rpx;
  border: var(--border-bold);
  border-radius: var(--radius-pill);
  background: var(--accent-yellow);
  line-height: 1;
  box-shadow: var(--shadow-hard);
  transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 120ms ease;
}
.paw-action--pressed { transform: translate(4rpx, 4rpx) scale(0.9); box-shadow: var(--shadow-pressed); }
.paw-image { display: block; width: 100%; height: 100%; }
.paw-caption {
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  background: var(--bg-cream);
  border: var(--border-bold);
  border-radius: var(--radius-pill);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
}
@media (prefers-reduced-motion: reduce) {
  .paw-action, .tab-item { transition: none; }
}
