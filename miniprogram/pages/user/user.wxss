/* 留味儿 · 萌系新粗野主义。保留全部文案和数据。 */
page { background-color: var(--bg-cream); color: var(--ink); }
.page-container, .display-container { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.header-section { display: flex; flex-direction: column; padding: 56rpx 40rpx 28rpx; }
.main-title { color: var(--ink); font-size: 56rpx; font-weight: 800; letter-spacing: 1rpx; }
.sub-title { margin-top: 12rpx; color: var(--muted-ink); font-size: 26rpx; }
.form-card { margin: 24rpx 40rpx; padding: 36rpx; background: var(--surface-white); border: var(--border-bold); border-radius: var(--radius-card); box-shadow: var(--shadow-hard); }
.form-group { margin-bottom: 36rpx; }
.label { display: inline-flex; margin-bottom: 16rpx; padding: 2rpx 16rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--pale-yellow); color: var(--ink); font-size: 24rpx; font-weight: 800; }
.custom-input { height: 96rpx; padding: 0 24rpx; background: var(--bg-cream); border: var(--border-bold); border-radius: var(--radius-pill); color: var(--ink); font-size: 30rpx; font-weight: 600; }
.input-placeholder { color: var(--muted-ink); font-weight: 400; }
.personality-group { display: flex; justify-content: space-between; gap: 20rpx; }
.hidden-radio { display: none; }
.p-card { position: relative; display: flex; flex: 1; min-width: 0; flex-direction: column; padding: 28rpx 20rpx; border: var(--border-bold); border-radius: var(--radius-card); background: var(--bg-cream); box-shadow: var(--shadow-hard); transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease; }
.p-card:active { transform: translate(4rpx, 4rpx); box-shadow: var(--shadow-pressed); }
.active-card { background: var(--pale-green); }
.p-emoji { position: relative; width: 80rpx; height: 80rpx; margin-bottom: 12rpx; font-size: 0; }
.personality-sticker { display: block; width: 100%; height: 100%; }
.p-title { margin-bottom: 8rpx; color: var(--ink); font-size: 34rpx; font-weight: 800; }
.active-text { color: var(--ink); }
.p-desc { color: var(--muted-ink); font-size: 23rpx; line-height: 1.65; }
.check-circle { position: absolute; top: 18rpx; right: 18rpx; display: flex; justify-content: center; align-items: center; width: 40rpx; height: 40rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--accent-yellow); color: var(--ink); font-size: 22rpx; font-weight: 800; }
.save-btn { display: flex; align-items: center; justify-content: center; min-height: 100rpx; margin-top: 44rpx; padding: 18rpx 24rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--primary-green); color: var(--ink); box-shadow: var(--shadow-hard); font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; line-height: 1.5; transition: transform 120ms ease, box-shadow 120ms ease; }
.save-btn:active { transform: translate(4rpx, 4rpx); box-shadow: var(--shadow-pressed); }

.display-container { padding-right: 40rpx; padding-left: 40rpx; }
.lb-item { position: relative; display: flex; align-items: center; min-height: 152rpx; margin-bottom: 32rpx; padding: 24rpx; border: var(--border-bold); border-radius: var(--radius-card); background: var(--surface-white); box-shadow: var(--shadow-hard); }
.my-profile-card { min-height: 240rpx; margin-bottom: 56rpx; padding: 28rpx; background: var(--pale-green); overflow: hidden; }
.profile-doodle { position: absolute; top: 12rpx; right: 16rpx; width: 108rpx; height: 100rpx; pointer-events: none; }
.bone-doodle { position: absolute; bottom: 8rpx; left: 164rpx; width: 82rpx; height: 60rpx; transform: rotate(10deg); pointer-events: none; }
.my-profile-card .avatar-wrap, .my-profile-card .lb-dog-info, .my-profile-card .lb-action { position: relative; z-index: 1; }
.my-profile-card .lb-action { align-self: flex-end; }
.me-tag { display: inline-block; margin-left: 8rpx; padding: 0 12rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--accent-yellow); color: var(--ink); font-size: 20rpx; font-weight: 800; vertical-align: middle; }
.edit-btn-small { padding: 10rpx 20rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--accent-yellow); color: var(--ink); box-shadow: 3rpx 3rpx 0 var(--ink); font-size: 24rpx; font-weight: 800; transition: transform 120ms ease, box-shadow 120ms ease; }
.edit-btn-small:active { transform: translate(2rpx, 2rpx); box-shadow: none; }
.lb-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin-bottom: 32rpx; }
.lb-header-left { position: relative; min-width: 0; flex: 1; padding-left: 74rpx; }
.leaderboard-trophy { position: absolute; top: 6rpx; left: 0; width: 62rpx; height: 62rpx; pointer-events: none; }
.lb-main-title { display: block; color: var(--ink); font-size: 40rpx; font-weight: 800; }
.lb-sub-title { display: block; margin-top: 8rpx; color: var(--muted-ink); font-size: 23rpx; line-height: 1.6; }
.lb-header-right { flex-shrink: 0; margin-bottom: 6rpx; padding: 6rpx 14rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--accent-yellow); color: var(--ink); font-size: 22rpx; font-weight: 800; }
.lb-item--even { background: var(--pale-green); }
.lb-item--first { background: var(--accent-yellow); }
.rank-wrap { flex-shrink: 0; display: flex; justify-content: center; width: 50rpx; margin-right: 12rpx; }
.rank-circle { display: flex; justify-content: center; align-items: center; width: 48rpx; height: 48rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--bg-cream); color: var(--ink); font-size: 26rpx; font-weight: 800; }
.rank-1 { background: var(--surface-white); transform: rotate(-6deg); }
.rank-2 { background: var(--surface-white); }
.rank-3 { background: var(--pale-yellow); }
.avatar-wrap { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin-right: 18rpx; border: var(--border-bold); border-radius: var(--radius-card); background: var(--bg-cream); overflow: hidden; }
.avatar-image { display: block; width: 100%; height: 100%; }
.lb-dog-info { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.lb-dog-name { color: var(--ink); font-size: 30rpx; font-weight: 800; overflow-wrap: break-word; }
.lb-dog-breed { margin-top: 4rpx; color: var(--muted-ink); font-size: 22rpx; overflow-wrap: break-word; }
.lb-distance { flex-shrink: 0; margin-left: 12rpx; padding: 6rpx 10rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--surface-white); }
.dist-num { color: var(--ink); font-size: 27rpx; font-weight: 800; white-space: nowrap; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 44rpx 32rpx; border: var(--border-bold); border-radius: var(--radius-card); background: var(--surface-white); box-shadow: var(--shadow-hard); color: var(--muted-ink); font-size: 26rpx; text-align: center; line-height: 1.8; }
.empty-doodle { width: 116rpx; height: 108rpx; margin-bottom: 20rpx; }
@media (prefers-reduced-motion: reduce) {
  .p-card, .save-btn, .edit-btn-small { transition: none; }
}

/* 统一头像组件：保留原有粗描边容器，透明插画完整显示。 */
.profile-avatar-preview { width: 120rpx; height: 120rpx; margin: 0 auto 32rpx; border: var(--border-bold); border-radius: var(--radius-card); background: var(--bg-cream); overflow: hidden; }
.pet-type-group { display: flex; gap: 20rpx; }
.pet-type-option { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 76rpx; padding: 10rpx 12rpx; border: var(--border-bold); border-radius: var(--radius-pill); background: var(--surface-white); color: var(--ink); font-size: 26rpx; font-weight: 800; }
.pet-type-option--selected { background: var(--accent-yellow); }
.save-btn[disabled] { opacity: 0.7; color: var(--ink); }
